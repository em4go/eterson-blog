---
import type {CollectionEntry} from 'astro:content';
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import {Image} from 'astro:assets';

type DataProps = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	prevHref,
	nextHref,
	readTime,
	lang = 'en',
	alternates,
} = Astro.props as DataProps & {
	prevHref?: string | null;
	nextHref?: string | null;
	readTime?: string;
	lang?: 'en' | 'es';
	alternates?: Array<{lang: 'en' | 'es'; href: string}>;
};
---

<Layout
	title={title}
	description={description}
	ogType='article'
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	image={heroImage}
	lang={lang}
>
	<!-- Top nav area consistent with home -->
	<div class='w-full bg-gray-900 px-4 sm:px-6 md:px-8'>
		<div class='max-w-7xl mx-auto'>
			<Header />
		</div>
	</div>

	<main class='w-full'>
		<article class='max-w-5xl mx-auto bg-gray-900 px-4 sm:px-6 md:px-8'>
			<!-- Title + meta -->
			<header class='pt-10 sm:pt-12 md:pt-16'>
				<p
					class='text-xs sm:text-sm tracking-widest text-emerald-300/90 uppercase'
				>
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class='ml-2 opacity-80'>
								• updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
					{readTime && <span class='ml-2'>• {readTime}</span>}
				</p>
				<h1
					class='mt-3 sm:mt-4 font-space-grotesk font-black uppercase tracking-tight leading-[0.95] text-5xl sm:text-6xl md:text-7xl text-cyan-50'
				>
					{title}
				</h1>
				<div
					class='mt-5 h-1 w-full bg-gradient-to-r from-cyan-400 to-transparent'
				>
				</div>
			</header>

			{
				alternates && alternates.length > 1 && (
					<div class='mt-4 flex gap-3 text-xs sm:text-sm uppercase tracking-widest'>
						<span class='opacity-70'>Read in:</span>
						{alternates.map((alt) => (
							<a
								href={alt.href}
								class={`underline decoration-dotted underline-offset-4 ${alt.lang === lang ? 'text-cyan-200' : 'text-cyan-300 hover:text-cyan-200'}`}
								aria-current={alt.lang === lang ? 'page' : undefined}
							>
								{alt.lang === 'en' ? 'English' : 'Español'}
							</a>
						))}
					</div>
				)
			}

			{
				heroImage && (
					<div class='mt-8'>
						<Image
							width={1280}
							height={640}
							src={heroImage}
							alt=''
							class='w-full rounded-sm shadow-[8px_8px_0_0_rgba(34,211,238,0.25)] ring-1 ring-cyan-400/30'
						/>
					</div>
				)
			}

			<div class='post-content mt-10 sm:mt-12 text-cyan-100'>
				<slot />
			</div>

			<script>
				// Function to style images based on HTML comments
				function styleImages(): void {
					const postContent = document.querySelector('.post-content');
					if (!postContent) return;

					// Find all HTML comments and the images that follow them
					const walker = document.createTreeWalker(
						postContent,
						NodeFilter.SHOW_COMMENT | NodeFilter.SHOW_ELEMENT
					);

					let node: Node | null;
					let pendingClasses: string[] = [];

					while ((node = walker.nextNode())) {
						if (node.nodeType === Node.COMMENT_NODE) {
							const comment = node.textContent?.trim() || '';

							// Parse image styling comments
							if (comment.includes('img-')) {
								pendingClasses = comment
									.split(/\s+/)
									.filter((cls) => cls.startsWith('img-'));
							}
						} else if (
							node.nodeType === Node.ELEMENT_NODE &&
							(node as Element).tagName === 'IMG'
						) {
							// Apply pending classes to this image
							if (pendingClasses.length > 0) {
								pendingClasses.forEach((cls) => {
									(node as HTMLElement).classList.add(cls);
								});
								pendingClasses = []; // Clear after applying
							}
						}
					}
				}

				// Function to add copy buttons and language labels to code blocks
				function enhanceCodeBlocks(): void {
					const preBlocks =
						document.querySelectorAll<HTMLElement>('.post-content pre');

					preBlocks.forEach((preEl: HTMLElement) => {
						const pre: HTMLElement = preEl;
						const codeBlock: HTMLElement | null = pre.querySelector('code');
						if (!pre || !pre.parentNode) return;

						// Skip if already enhanced
						if (
							pre.parentElement &&
							pre.parentElement.classList.contains('code-block-wrapper')
						)
							return;

						// Create wrapper
						const wrapper = document.createElement('div');
						wrapper.className = 'code-block-wrapper';
						(wrapper.style as any).display = 'block';

						// Get language from various possible sources
						function detectLanguage(
							preEl: HTMLElement,
							codeEl: HTMLElement | null
						): string {
							// 1) data attributes commonly used by highlighters (Shiki, Prism, etc.)
							const dataCandidates = [
								(codeEl && codeEl.getAttribute('data-language')) || null,
								(codeEl && codeEl.getAttribute('data-lang')) || null,
								preEl.getAttribute('data-language'),
								preEl.getAttribute('data-lang'),
							].filter(Boolean);

							if (dataCandidates.length > 0)
								return String(dataCandidates[0] ?? '');

							// 2) class names like language-xxx or lang-xxx on code or pre
							const classes: string[] = [
								...(codeEl ? Array.from(codeEl.classList) : []),
								...Array.from(preEl.classList),
							] as unknown as string[];
							const cls = classes.find(
								(c: string) =>
									c && (c.startsWith('language-') || c.startsWith('lang-'))
							);
							if (cls)
								return cls.replace(/^language-/, '').replace(/^lang-/, '');

							// 3) fallback: try to infer from code fence info preserved in title attribute (rare)
							const titleAttr =
								(codeEl && codeEl.getAttribute('title')) ||
								preEl.getAttribute('title');
							if (titleAttr) return String(titleAttr);

							return '';
						}

						const language = detectLanguage(pre, codeBlock);
						try {
							console.debug('[codeblock] detected language:', language, {
								classes: pre.className,
								codeClasses: codeBlock?.className,
							});
						} catch {}

						// Prepare language label (append inside <pre> so it's within the code box)
						const label = document.createElement('span');
						label.className = 'code-language-label';
						label.textContent = language || 'text';

						// Create copy button
						const copyButton = document.createElement('button');
						copyButton.className = 'copy-button';
						copyButton.innerHTML = `
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
								<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
							</svg>
						`;
						copyButton.setAttribute('aria-label', 'Copy code to clipboard');

						// Copy functionality
						copyButton.addEventListener('click', async () => {
							const codeText =
								codeBlock && codeBlock.textContent
									? codeBlock.textContent
									: pre.textContent || '';
							try {
								await navigator.clipboard.writeText(codeText);
								copyButton.classList.add('copied');
								copyButton.innerHTML = `
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
								`;

								setTimeout(() => {
									copyButton.classList.remove('copied');
									copyButton.innerHTML = `
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
											<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
										</svg>
									`;
								}, 2000);
							} catch (err) {
								console.error('Failed to copy code: ', err);
							}
						});

						// Add controls inside the <pre> so they are inside the visual code box
						pre.appendChild(copyButton);

						// Wrap the pre element
						if (pre.parentNode) {
							pre.parentNode.insertBefore(wrapper, pre);
							wrapper.appendChild(pre);
							pre.appendChild(label);
						}
					});
				}

				// Run when DOM is ready
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', () => {
						styleImages();
						enhanceCodeBlocks();
					});
				} else {
					styleImages();
					enhanceCodeBlocks();
				}

				// Also run after Astro view transitions
				document.addEventListener('astro:after-swap', () => {
					styleImages();
					enhanceCodeBlocks();
				});
			</script>

			<nav
				class='mt-12 sm:mt-16 grid grid-cols-3 items-center text-xs sm:text-sm uppercase tracking-widest'
			>
				<div class='justify-self-start'>
					{
						prevHref && (
							<a
								href={prevHref}
								class='text-cyan-300 hover:text-cyan-200 underline decoration-dotted underline-offset-4'
							>
								← Previous Post
							</a>
						)
					}
				</div>
				<div class='justify-self-center'>
					<a
						href={`/blog/${lang}/`}
						class='text-cyan-300 hover:text-cyan-200 underline decoration-dotted underline-offset-4'
					>
						Back to blog
					</a>
				</div>
				<div class='justify-self-end'>
					{
						nextHref && (
							<a
								href={nextHref}
								class='text-cyan-300 hover:text-cyan-200 underline decoration-dotted underline-offset-4'
							>
								Next Post →
							</a>
						)
					}
				</div>
			</nav>
			<div
				class='my-10 h-[1px] w-full bg-gradient-to-r from-transparent via-cyan-400/30 to-transparent'
			>
			</div>
		</article>
	</main>

	<style is:global>
		/* Post typography styling to match the site's dark aesthetic */
		.post-content {
			display: block;
		}
		.post-content h1,
		.post-content h2,
		.post-content h3,
		.post-content h4,
		.post-content h5,
		.post-content h6 {
			color: #e9d5ff;
			letter-spacing: -0.01em;
			line-height: 1.1;
			margin: 2.25rem 0 0.75rem;
			font-family: 'Space Grotesk', sans-serif;
			font-weight: 800;
		}
		/* Proportional scale based on paragraph size */
		.post-content h1 {
			font-size: calc(var(--p-size) * 2.5);
		}
		.post-content h2 {
			font-size: calc(var(--p-size) * 2);
		}
		.post-content h3 {
			font-size: calc(var(--p-size) * 1.6);
		}
		.post-content h4 {
			font-size: calc(var(--p-size) * 1.35);
		}
		.post-content h5 {
			font-size: calc(var(--p-size) * 1.2);
		}
		.post-content h6 {
			font-size: calc(var(--p-size) * 1.1);
		}

		.post-content p,
		.post-content li {
			color: #cffafe;
			margin: 0.85rem 0;
			font-size: var(--p-size);
			line-height: var(--p-leading);
		}

		.post-content a {
			color: #67e8f9;
			text-decoration: underline;
			text-decoration-style: dotted;
			text-underline-offset: 4px;
		}
		.post-content a:hover {
			color: #a5f3fc;
		}

		.post-content hr {
			border: 0;
			height: 2px;
			margin: 2rem 0;
			background: linear-gradient(
				90deg,
				rgba(34, 211, 238, 0.6),
				rgba(34, 211, 238, 0)
			);
		}

		/* Code blocks */
		.post-content pre {
			background: #0f172a; /* slate-900 */
			color: #e2e8f0; /* slate-200 */
			border-left: 6px solid #22d3ee; /* cyan-400 */
			border-radius: 0;
			padding: 1rem 1.25rem;
			overflow: auto;
			box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.15) inset;
			margin: 1.25rem 0;
			font-family: 'IBM Plex Mono', monospace;
			font-size: 0.95rem;
		}
		.post-content code {
			font-family: 'IBM Plex Mono', monospace;
			background: rgba(2, 132, 199, 0.12); /* sky-600/12 */
			color: #e0f2fe;
			padding: 0.15rem 0.35rem;
			border-radius: 2px;
		}
		.post-content pre code {
			background: transparent;
			padding: 0;
		}

		/* Code block container with relative positioning for copy button */
		.post-content .code-block-wrapper {
			position: relative;
			margin: 1.25rem 0;
		}

		/* Language label */
		.post-content .code-language-label {
			position: absolute;
			top: 0.5rem;
			left: 0.5rem;
			background: rgba(34, 211, 238, 0.25);
			color: #22d3ee;
			padding: 0.25rem 0.5rem;
			border-radius: 0.25rem;
			font-size: 0.75rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			z-index: 30;
			pointer-events: none;
			box-shadow:
				0 0 0 1px rgba(34, 211, 238, 0.35),
				0 2px 6px rgba(0, 0, 0, 0.25);
		}

		/* Copy button */
		.post-content .copy-button {
			position: absolute;
			top: 0.5rem;
			right: 0.5rem;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2rem;
			height: 2rem;
			padding: 0;
			border-radius: 0.375rem;
			background: transparent; /* minimal by default */
			border: 1px solid transparent; /* no visible border by default */
			color: #e9d5ff;
			cursor: pointer;
			transition:
				background 0.15s ease,
				border-color 0.15s ease,
				transform 0.05s ease,
				opacity 0.15s ease;
			z-index: 40; /* above code text */
			opacity: 0.9;
			appearance: none;
			-webkit-appearance: none;
			outline: none;
			box-shadow: none;
			line-height: 1;
			overflow: hidden;
		}

		.post-content .copy-button:hover {
			background: rgba(167, 139, 250, 0.18);
			border-color: rgba(167, 139, 250, 0.35);
			opacity: 1;
		}

		.post-content .copy-button.copied {
			background: rgba(34, 197, 94, 0.18);
			color: #86efac;
			border-color: rgba(34, 197, 94, 0.45);
		}

		/* Icon sizing inside the copy button */
		.post-content .copy-button svg {
			width: 1rem;
			height: 1rem;
			display: block;
			color: currentColor;
			opacity: 0.95;
		}

		/* Focus styles for accessibility */
		.post-content .copy-button:focus-visible {
			outline: 2px solid rgba(167, 139, 250, 0.6);
			outline-offset: 2px;
		}

		/* Adjust pre styling: position relative so controls sit inside; reserve top space */
		.post-content .code-block-wrapper pre {
			margin: 0;
			position: relative;
			padding-top: 2.5rem; /* Reserve space for label and button inside box */
		}

		/* Blockquotes */
		.post-content blockquote {
			margin: 1.5rem 0;
			padding: 0.75rem 1rem;
			border-left: 6px solid #a78bfa; /* purple-400 */
			background: rgba(167, 139, 250, 0.07);
			color: #e9d5ff; /* purple-200 */
			font-style: italic;
		}

		.post-content ul {
			list-style: disc;
			padding-left: 1.25rem;
		}
		.post-content ol {
			list-style: decimal;
			padding-left: 1.25rem;
		}

		.post-content img {
			border-radius: 2px;
			box-shadow: 8px 8px 0 0 rgba(124, 58, 237, 0.35);
		}

		/* Image styling classes */
		.post-content .img-center {
			display: block;
			margin: 1.5rem auto;
		}

		.post-content .img-xsmall {
			max-width: 300px;
			width: 100%;
		}

		.post-content .img-small {
			max-width: 400px;
			width: 100%;
		}

		.post-content .img-medium {
			max-width: 600px;
			width: 100%;
		}

		.post-content .img-large {
			max-width: 800px;
			width: 100%;
		}

		.post-content .img-no-shadow {
			box-shadow: none;
		}

		.post-content .img-rounded {
			border-radius: 8px;
		}
	</style>
</Layout>
